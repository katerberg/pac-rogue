{
  "name": "pac-rogue",
  "private": true,
  "version": "0.0.1",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "PAC_ROGUE_AGENT=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:agent": "PAC_ROGUE_AGENT=1 vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p worker/tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual": "node scripts/visual-smoke.mjs",
    "probe": "node scripts/play-probe.mjs",
    "check:ecs": "node scripts/check-ecs-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:precommit": "npm run typecheck && npm run lint && npm run format:check && npm run check:ecs && npm run check:docs && npm run test",
    "verify": "npm run verify:precommit && npm run build && npm run visual",
    "verify:record": "node scripts/record-verify.mjs",
    "check:ship": "node scripts/check-ship-evidence.mjs",
    "worker:migrate:local": "wrangler d1 migrations apply dot-man-api --local --config worker/wrangler.toml",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local --port 8787",
    "worker:dev:agent": "wrangler dev --config worker/wrangler.toml --local --port 8788",
    "data:pull": "node scripts/data-pull.mjs",
    "balance": "node scripts/balance.mjs",
    "balance:compare": "node scripts/balance.mjs --compare",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "bitecs": "^0.4.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261006.1": true
  }
}
